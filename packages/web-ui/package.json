{
  "name": "@satelink/web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Satelink Signal — the public-website design system (tokens + components). Shared by apps/web (satelink.network) and apps/corporate (jakuraa.com). Distinct from @satelink/ui, which is the OS/admin dashboard system.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/components/ui/index.ts",
    "./ui/*": "./src/components/ui/*.tsx",
    "./site": "./src/components/site/index.ts",
    "./site/*": "./src/components/site/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "next": "^15",
    "react": "^18",
    "react-dom": "^18"
  }
}
