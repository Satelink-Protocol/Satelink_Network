{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/identity/:path*",
      "destination": "https://api.satelink.network/api/identity/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "status.satelink.network"
        }
      ],
      "destination": "/_status/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.satelink.network"
        }
      ],
      "destination": "/satelink/os/mission-control",
      "permanent": false
    }
  ]
}