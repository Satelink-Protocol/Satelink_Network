# apps/web environment variables (§8). Copy to .env.local for local dev.
# NEVER commit real secrets. NEXT_PUBLIC_* are inlined into the client bundle
# (not secret); everything else is server-only.

# ---- API wiring ----
# Base URL of apps/api. Server-side calls (Dodo account resolution, catalog).
INTERNAL_API_URL=http://localhost:8080
# Public API base used by the browser + ISR catalog fetch.
NEXT_PUBLIC_API_BASE=https://rpc.satelink.network
# Some legacy client pages read this instead of NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_API_URL=https://rpc.satelink.network
# Absolute site origin — used to build the Dodo return_url. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://satelink.network

# ---- Dodo Payments (Trading Intelligence checkout) ----
# "productId:usdValue:Label" list. MUST match apps/api DODO_CREDIT_PACK_USD_VALUES.
# Example: pdt_abc123:9.99:Starter Pack
NEXT_PUBLIC_DODO_CREDIT_PACKS=
# Dodo SDK bearer token (server-only).
DODO_PAYMENTS_API_KEY=
# "test_mode" | "live_mode". REQUIRED in production (no silent live default).
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Shared secret for apps/api /internal/dodo/* (resolve-account, create-claim).
DODO_INTERNAL_SECRET=

# ---- Feature flags ----
# Monthly Dodo subscriptions — default OFF (renewal-refund matching not built).
NEXT_PUBLIC_DODO_SUBSCRIPTIONS_ENABLED=false

# ---- Corporate enquiry (TODO: email provider) ----
# No transactional email backend is configured; /api/corporate-enquiry
# server-logs the enquiry. Add a provider (e.g. RESEND_API_KEY) to deliver.
# RESEND_API_KEY=
