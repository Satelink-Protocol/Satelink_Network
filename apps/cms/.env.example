# apps/cms (Payload 3). Copy to .env. NEVER commit real secrets.

# Postgres — local dev DB (a local Postgres is running on :5432) OR the
# satelink_cms database on the existing Railway instance (see INFRA_SETUP.md).
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/satelink_cms_dev

# Payload secret (openssl rand -hex 32). REQUIRED.
PAYLOAD_SECRET=change-me-64-hex

# Public server URL (admin origin).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3200

# Vercel Blob media adapter (prod). Leave blank for local disk in dev.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the on-publish → public revalidateTag webhook.
CMS_REVALIDATE_SECRET=change-me

# Public site origins to revalidate on publish.
SATELINK_WEB_URL=http://localhost:3000
JAKURAA_WEB_URL=http://localhost:3001
