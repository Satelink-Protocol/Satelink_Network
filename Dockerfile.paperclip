FROM node:22-alpine
LABEL description="Satelink Paperclip — AI Agent Orchestration Layer"
RUN apk add --no-cache postgresql-client
WORKDIR /app
COPY .npmrc ./
RUN npm install -g paperclipai@latest
COPY agent/ ./agent/
COPY start-cloud.sh ./
RUN chmod +x start-cloud.sh
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=10 \
  CMD wget -qO- http://localhost:8081/health || exit 1
CMD ["sh", "start-cloud.sh"]
