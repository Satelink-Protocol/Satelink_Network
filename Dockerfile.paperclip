FROM node:20-alpine
LABEL description="Satelink Paperclip — AI Agent Orchestration Layer"
WORKDIR /app

ENV npm_config_legacy_peer_deps=true
RUN npm install -g paperclipai@latest

COPY agent/ ./agent/
COPY start-cloud.sh ./
RUN chmod +x start-cloud.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
CMD ["sh", "start-cloud.sh"]
